@model Capital_Item_Justification.ViewModels.PaginationViewModel

@if (Model.TotalRecords > 0)
{
    <div class="d-flex justify-content-between align-items-center mt-3">

        <!-- Record Information -->
        <div class="text-muted">
            Showing
            <strong>
                @(((Model.CurrentPage - 1) * Model.PageSize) + 1)
            </strong>
            -
            <strong>
                @(Math.Min(
                    Model.CurrentPage * Model.PageSize,
                    Model.TotalRecords))
            </strong>
            of
            <strong>@Model.TotalRecords</strong>
            records
        </div>

        <!-- Pagination -->
        <nav>
            <ul class="pagination mb-0">

                @{
                    var previousRoute = new Dictionary<string, string?>(
                    Model.RouteValues)
                {
                    ["page"] = (Model.CurrentPage - 1).ToString(),
                    ["pageSize"] = Model.PageSize.ToString()
                };

                    var nextRoute = new Dictionary<string, string?>(
                    Model.RouteValues)
                {
                    ["page"] = (Model.CurrentPage + 1).ToString(),
                    ["pageSize"] = Model.PageSize.ToString()
                };
                }

                <!-- Previous -->
                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="@Model.ControllerName"
                       asp-action="@Model.ActionName"
                       asp-all-route-data="previousRoute">

                        Previous
                    </a>

                </li>

                <!-- Page Numbers -->
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    var pageRoute = new Dictionary<string, string?>(
                    Model.RouteValues)
                    {
                        ["page"] = i.ToString(),
                        ["pageSize"] = Model.PageSize.ToString()
                    };

                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">

                        <a class="page-link"
                           asp-controller="@Model.ControllerName"
                           asp-action="@Model.ActionName"
                           asp-all-route-data="pageRoute">

                            @i

                        </a>

                    </li>
                }

                <!-- Next -->

                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="@Model.ControllerName"
                       asp-action="@Model.ActionName"
                       asp-all-route-data="nextRoute">

                        Next

                    </a>

                </li>

            </ul>
        </nav>

    </div>
}