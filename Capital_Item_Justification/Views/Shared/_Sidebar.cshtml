@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool isDepartmentActive =
        currentController == "Department" &&
        currentAction == "GetAllDept";

    bool isProjectActive =
        currentController == "Project" &&
        currentAction == "GetProjects";

    bool isLocationActive =
        currentController == "Location" &&
        currentAction == "GetAllLocation";

    bool isUserActive =
        currentController == "User" &&
        currentAction == "GetUsers";

    bool isRoleActive =
        currentController == "Role" &&
        currentAction == "GetRoles";

    bool isRoleBudgetLimitActive =
        currentController == "RoleBudgetLimit" &&
        currentAction == "GeRoleBudgetLimit";

    bool isMastersActive =
        isDepartmentActive ||
        isProjectActive ||
        isLocationActive ||
        isUserActive ||
        isRoleActive ||
        isRoleBudgetLimitActive;
}
@{
    var currentController1 = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction1 = ViewContext.RouteData.Values["action"]?.ToString();

    bool isCreateCIJActive =
        currentController1 == "CIJ" &&
        currentAction1 == "CreateCIJ";

    bool isMyRequestsActive =
        currentController1 == "CIJ" &&
        currentAction1 == "MyRequests";

    bool isTrackRequestActive =
        currentController1 == "WorkFlow" &&
        currentAction1 == "TrackRequest";

    bool isCIJRequestActive = isCreateCIJActive || isMyRequestsActive || isTrackRequestActive;

}
<aside class="app-sidebar bg-body-secondary shadow"
       data-bs-theme="dark">

    <!-- Brand -->
    <div class="sidebar-brand">
        <a>
            <img src="~/image/Sceh-Logo.png"
                 alt="SCEH Logo"
                 class="brand-image opacity-75 shadow">
            <span class="brand-text fw-semibold">
                CIJ
            </span>
        </a>

    </div>

    <!-- Sidebar Wrapper -->
    <div class="sidebar-wrapper">

        <nav class="mt-2">

            <ul class="nav sidebar-menu flex-column"
                data-lte-toggle="treeview"
                role="menu"
                data-accordion="false">

                <!-- Dashboard -->
                @if (User.IsInRole("Requester"))
                {
                    <li class="nav-item">

                        <a asp-controller="CIJ"
                           asp-action="Dashboard"
                           class="nav-link">
                            <i class="nav-icon bi bi-speedometer2"></i>
                            <p>
                                My Dashboard
                            </p>
                        </a>
                    </li>


                }
                @if (!User.IsInRole("Requester"))
                {
                    <li class="nav-item">
                        <a asp-controller="WorkFlow"
                           asp-action="MyApproval"
                           class="nav-link">
                            <i class="nav-icon bi bi-list-check"></i>
                            <p>
                                Pending Approval
                            </p>
                        </a>
                    </li>
                }
                @if (User.IsInRole("Purchase"))
                {
                    <li class="nav-item">
                        <a asp-controller="WorkFlow"
                           asp-action="CompletedApproval"
                           class="nav-link">
                            <i class="nav-icon bi bi-check2-all"></i>
                            <p>
                                Completed Approval
                            </p>
                        </a>
                    </li>
                }
                @if (User.IsInRole("Requester"))
                {

                    <li class="nav-item @(isCIJRequestActive ? "menu-open" : "")">

                        <a href="#" class="nav-link @(isCIJRequestActive ? "active" : "")">
                            <i class="nav-icon bi bi-file-earmark-text"></i>
                            <p>
                                CIJ Request
                                <i class="nav-arrow bi bi-chevron-right"></i>
                            </p>
                        </a>


                        <!-- CIJ Sub Menu -->
                        <ul class="nav nav-treeview">

                            <!-- Create CIJ -->
                            <li class="nav-item">
                                <a asp-controller="CIJ"
                                   asp-action="CreateCIJ"
                                   class="nav-link @(isCreateCIJActive ? "active" : "")">
                                    <i class="nav-icon bi bi-file-earmark-plus"></i>
                                    <p>
                                        Create CIJ
                                    </p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="CIJ"
                                   asp-action="MyRequests"
                                   class="nav-link @(isMyRequestsActive ? "active" : "")">
                                    <i class="nav-icon bi bi-file-earmark-text"></i>
                                    <p>
                                        My Requests
                                    </p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="WorkFlow"
                                   asp-action="TrackRequest"
                                   class="nav-link @(isTrackRequestActive ? "active" : "")">
                                    <i class="nav-icon bi bi-search"></i>
                                    <p>
                                        Request Tracking
                                    </p>
                                </a>
                            </li>
                        </ul>

                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item @(isMastersActive ? "menu-open" : "")">
                        <a href="#" class="nav-link @(isMastersActive ? "active" : "")">
                            <i class="nav-icon bi bi-sliders"></i>
                            <p>
                                Masters
                                <i class="nav-arrow bi bi-chevron-right"></i>
                            </p>
                        </a>


                        <!-- Masters Sub Menu -->
                        <ul class="nav nav-treeview">

                            <!-- Department -->
                            <li class="nav-item">

                                <a href="@Url.Action("GetAllDept","Department")" class="nav-link @(isDepartmentActive ? "active" : "")">

                                    <i class="nav-icon bi bi-diagram-3"></i>

                                    <p>
                                        Department
                                    </p>

                                </a>

                            </li>

                            <li class="nav-item">

                                <a href="@Url.Action("GetProjects","Project")"
                                   class="nav-link @(isProjectActive ? "active" : "")">

                                    <i class="nav-icon bi bi-kanban"></i>

                                    <p>
                                        Project
                                    </p>

                                </a>

                            </li>

                            <!-- Location -->
                            <li class="nav-item">

                                <a href="@Url.Action("GetAllLocation","Location")"
                                   class="nav-link @(isLocationActive ? "active" : "")">

                                    <i class="nav-icon bi bi-geo-alt"></i>

                                    <p>
                                        Location
                                    </p>

                                </a>

                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("GetUsers","User")"
                                   class="nav-link @(isUserActive ? "active" : "")">
                                    <i class="nav-icon bi bi-person"></i>
                                    <p>
                                        User
                                    </p>

                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("GetRoles","Role")"
                                   class="nav-link @(isRoleActive ? "active" : "")">
                                    <i class="nav-icon bi bi-person-badge"></i>
                                    <p>
                                        Role
                                    </p>

                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("GeRoleBudgetLimit","RoleBudgetLimit")"
                                   class="nav-link @(isRoleBudgetLimitActive ? "active" : "")">
                                    <i class="nav-icon bi bi-currency-rupee"></i>
                                    <p>
                                        Role BudgetLimit
                                    </p>

                                </a>
                            </li>
                        </ul>

                    </li>

                }
            </ul>

        </nav>

    </div>

</aside>