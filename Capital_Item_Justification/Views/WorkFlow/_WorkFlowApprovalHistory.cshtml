@model Capital_Item_Justification.ViewModels.ApprovalDetailViewModel
<div class="card card-primary card-outline mb-3">
    <div class="card-header">
        <h3 class="card-title">
            <i class="bi bi-clock-history me-2"></i>
            Approval History
        </h3>
    </div>
    <div class="card-body">
        @if (Model.workflowHistory != null && Model.workflowHistory.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Role</th>
                            <th>Action By</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var history in Model.workflowHistory)
                        {
                            <tr>
                                <td>
                                    @history.ActionDate?.ToString("dd-MMM-yyyy HH:mm")
                                </td>
                                <td>
                                    @history.RoleName
                                </td>
                                <td>
                                    @history.UserName
                                </td>
                                <td>
                                    @if (history.StatusName == "Submitted")
                                    {
                                        <span class="bg-primary">
                                            Submitted
                                        </span>
                                    }
                                    @if (history.StatusName == "Approved")
                                    {
                                        <span class="bg-success">
                                            Approved
                                        </span>
                                    }
                                </td>
                                <td>
                                    @history.Remark
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                No approval history available.
            </div>
        }

    </div>
</div>