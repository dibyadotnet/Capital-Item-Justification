@model Capital_Item_Justification.ViewModels.CompletedRequestsListViewModel

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
    </div>
    <!-- Approval Card -->
    <div class="card shadow-sm">

        <div class="card-header">
            <strong class="bi bi-check2-square me-2">
                Completed Approval
            </strong>
        </div>
        <div class="px-3 pt-3">
            <form asp-controller="WorkFlow" asp-action="CompletedApproval" method="get" class="mb-0">

                @{
                    var departmentId = Context.Request.Query["departmentId"].ToString();
                    var locationId = Context.Request.Query["locationId"].ToString();
                    var fromDate = Context.Request.Query["fromDate"].ToString();
                    var toDate = Context.Request.Query["toDate"].ToString();
                }

                <div class="row g-3 align-items-end">

                    <!-- Department -->
                    <div class="col-lg-2 col-md-6">
                        <label for="departmentId" class="form-label">Department</label>
                        <select id="departmentId" name="departmentId"
                                class="form-select form-select-sm">
                            <option value="">Select Department</option>
                            @foreach (SelectListItem dept in ViewBag.Departments)
                            {
                                <option value="@dept.Value"
                                        selected="@(departmentId == dept.Value)">
                                    @dept.Text
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Location -->
                    <div class="col-lg-2 col-md-6">
                        <label for="locationId" class="form-label">Location</label>
                        <select id="locationId" name="locationId"
                                class="form-select form-select-sm">
                            <option value="">Select Location</option>
                            @foreach (SelectListItem loc in ViewBag.Locations)
                            {
                                <option value="@loc.Value"
                                        selected="@(locationId == loc.Value)">
                                    @loc.Text
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Date From -->
                    <div class="col-lg-2 col-md-6">
                        <label for="fromDate" class="form-label">Date From</label>
                        <input type="date" id="fromDate" name="fromDate"
                               value="@fromDate"
                               class="form-control form-control-sm" />
                    </div>

                    <!-- Date To -->
                    <div class="col-lg-2 col-md-6">
                        <label for="toDate" class="form-label">Date To</label>
                        <input type="date" id="toDate" name="toDate"
                               value="@toDate"
                               class="form-control form-control-sm" />
                    </div>

                    <!-- Filter and Reset -->
                    <div class="col-lg-2 col-md-6">
                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary btn-sm">
                                <i class="bi bi-search"></i> Filter
                            </button>

                            <a asp-controller="WorkFlow"
                               asp-action="CompletedApproval" style="height: 37px;"
                               class="btn btn-secondary btn-sm">
                                Reset
                            </a>
                        </div>
                    </div>

                    <!-- Show page size -->
                    <div class="col-lg-2 col-md-6">
                        <div class="d-flex justify-content-lg-end align-items-center gap-2">
                            <label for="pageSize" class="mb-0">Show:</label>

                            <select id="pageSize" name="pageSize"
                                    class="form-select form-select-sm"
                                    style="width: 80px;"
                                    onchange="this.form.submit()">
                                <option value="10"
                                        selected="@(Model.Pagination.PageSize == 10)">10</option>
                                <option value="25"
                                        selected="@(Model.Pagination.PageSize == 25)">25</option>
                                <option value="50"
                                        selected="@(Model.Pagination.PageSize == 50)">50</option>
                            </select>
                        </div>
                    </div>

                    <input type="hidden" name="page" value="1" />

                </div>
            </form>
        </div>
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>CIJ Number</th>
                            <th>Request Date</th>
                            <th>Completion Date</th>
                            <th>Department</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.completedRequestViewModels.Any())
                        {
                            var index = 1;

                            foreach (var item in Model.completedRequestViewModels)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @item.CIJNumber
                                        </strong>
                                    </td>
                                    <td>
                                        @item.RequestDate?.ToString("dd-MMM-yyyy")
                                    </td>
                                    <td>
                                        @item.CompletionDate?.ToString("dd-MMM-yyyy")
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.DepartmentName))
                                        {
                                            @item.DepartmentName
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.LocationName))
                                        {
                                            @item.LocationName
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>

                                    <td>

                                        <span class="badge bg-primary text-dark">
                                            @item.StatusName
                                        </span>
                                    </td>

                                    <td class="text-center">

                                        <a asp-controller="WorkFlow"
                                           asp-action="ViewCIJRequest"
                                           asp-route-approvalId="0"
                                           asp-route-cijId="@item.CIJId"
                                           class="btn btn-sm btn-primary btn-edit" title="View CIJ">
                                            <i class="bi bi-eye me-1"></i>
                                        </a>

                                        <a asp-controller="GeneratePDF"
                                           asp-action="DownloadCIJPDF"
                                           asp-route-cijId="@item.CIJId"
                                           class="btn btn-sm btn-danger btn-edit" title="Download CIJ PDF">
                                            <i class="bi bi-file-earmark-pdf"></i>
                                        </a>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="bi bi-check-circle fs-3"></i>
                                        <h6 class="mt-2">No completed CIJ requests found</h6>
                                        <small>
                                            There are currently no completed requests matching your filters.
                                        </small>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
                <partial name="_Pagination" model="Model.Pagination" />
            </div>

        </div>

    </div>

</div>