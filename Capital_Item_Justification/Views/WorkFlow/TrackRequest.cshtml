@model Capital_Item_Justification.ViewModels.TrackMyRequestListViewModel
<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-search me-2"></i>
                Track My Request
            </h5>
        </div>
        <div class="px-3 pt-3">
            @{
                var fromDate = Context.Request.Query["fromDate"].ToString();
                var toDate = Context.Request.Query["toDate"].ToString();
            }
            <form asp-controller="WorkFlow" asp-action="TrackRequest" method="get" class="mb-0">

                <div class="row g-3 align-items-end">
                    <div class="col-lg-3 col-md-6">
                        <label for="cijNumber" class="form-label">CIJ Number</label>
                        <select id="CijId" name="cijId" class="form-select" asp-items="ViewBag.CIJNumberList">
                            <option value="">-- Select CIJNumber --</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label for="statusId" class="form-label">Status</label>
                        <select id="StausId" name="statusId" class="form-select" asp-items="ViewBag.StatusList">
                            <option value="">-- Select Status --</option>
                        </select>
                    </div>

                    <!-- Date From -->
                    <div class="col-lg-2 col-md-6">
                        <label for="fromDate" class="form-label">Date From</label>
                        <input type="date" id="fromDate" name="fromDate"
                               value="@fromDate"
                               class="form-control form-control-sm" />
                    </div>

                    <!-- Date To -->
                    <div class="col-lg-2 col-md-6">
                        <label for="toDate" class="form-label">Date To</label>
                        <input type="date" id="toDate" name="toDate"
                               value="@toDate"
                               class="form-control form-control-sm" />
                    </div>

                    <!-- Filter and Reset -->
                    <div class="col-lg-1 col-md-6">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm">
                                 Filter
                            </button>

                            <a asp-controller="WorkFlow"
                               asp-action="TrackRequest" style="height: 37px;"
                               class="btn btn-secondary btn-sm">
                                Reset
                            </a>
                        </div>
                    </div>

                    <!-- Show page size -->
                    <div class="col-lg-2 col-md-6">
                        <div class="d-flex justify-content-lg-end align-items-center gap-2">
                           @*  <label for="pageSize" class="mb-0">Show:</label> *@

                            <select id="pageSize" name="pageSize"
                                    class="form-select form-select-sm"
                                    style="width: 80px;"
                                    onchange="this.form.submit()">
                                <option value="10"
                                        selected="@(Model.Pagination.PageSize == 10)">10</option>
                                <option value="25"
                                        selected="@(Model.Pagination.PageSize == 25)">25</option>
                                <option value="50"
                                        selected="@(Model.Pagination.PageSize == 50)">50</option>
                            </select>
                        </div>
                    </div>

                    <input type="hidden" name="page" value="1" />

                </div>
            </form>
        </div>
        <div class="card-body">
            @if (Model.requestTrackings.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                @* <th>#</th> *@
                                <th>CIJ Number</th>
                                <th>Request Date</th>
                                <th>Current Owner</th>
                                <th>Department</th>
                                <th>Location</th>
                                <th>Pending/Completed</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                var index = 1;
                            }

                            @foreach (var item in Model.requestTrackings)
                            {
                                <tr>
                                    @*  <td>
                                        @index
                                        </td>*@
                                    <td>
                                        @item.CIJNumber
                                    </td>
                                    <td>
                                        @item.RequestDate?.ToString("dd-MMM-yyyy")
                                    </td>
                                    <td>
                                        @item.ApproverRole
                                    </td>
                                    <td>
                                        @item.DepartmentName
                                    </td>
                                    <td>
                                        @item.LocationName
                                    </td>
                                    <td>
                                        @(item.PendingSince?.ToString("dd-MMM-yyyy") ?? "-")
                                    </td>
                                    <td>
                                        <span class="badge
    @(item.CurrentStatus?.Equals("Pending", StringComparison.OrdinalIgnoreCase) == true
        ? "bg-warning text-dark"
        : item.CurrentStatus?.Equals("Rejected", StringComparison.OrdinalIgnoreCase) == true
            ? "bg-danger text-dark"
            : "bg-primary text-dark")">
                                            @item.CurrentStatus
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-controller="WorkFlow"
                                           asp-action="ViewCIJRequest"
                                           asp-route-approvalId="@item.WorkflowApprovalId"
                                           asp-route-cijId="@item.CijId"
                                           class="btn btn-sm btn-primary btn-edit" title="View CIJ">
                                            <i class="bi bi-eye me-1"></i>
                                        </a>
                                        <a asp-controller="GeneratePDF"
                                           asp-action="DownloadCIJPDF"
                                           asp-route-cijId="@item.CijId"
                                           class="btn btn-sm btn-danger btn-edit" title="Download CIJ PDF">
                                            <i class="bi bi-file-earmark-pdf"></i>
                                        </a>
                                    </td>

                                </tr>

                                index++;
                            }

                        </tbody>

                    </table>
                    <partial name="_Pagination" model="Model.Pagination" />
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    You have not raised any requests with pending approval.
                </div>
            }
        </div>
    </div>
</div>
