@model Capital_Item_Justification.ViewModels.MyApprovalListViewModel

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
    </div>
    <!-- Approval Card -->
    <div class="card shadow-sm">

        <div class="card-header">
            <strong class="bi bi-check2-square me-2">
                @ViewBag.Page Approval
            </strong>
        </div>
        <div class="d-flex justify-content-end align-items-center px-3 mt-1">
            @{
                var actionName = ViewBag.Page?.ToString() == "Completed"
                ? "CompletedApproval"
                : "MyApproval";
            }
           
                    <form asp-controller="WorkFlow"
                          asp-action="@actionName"
                          method="get"
                          class="d-flex align-items-center gap-2 mb-0">
                <label for="pageSize" class="mb-0">Show:</label>

                <select id="pageSize"
                        name="pageSize"
                        class="form-select form-select-sm"
                        style="width: 80px;"
                        onchange="this.form.submit()">

                    <option value="10" selected="@(Model.Pagination.PageSize == 10)">10</option>
                    <option value="25" selected="@(Model.Pagination.PageSize == 25)">25</option>
                    <option value="50" selected="@(Model.Pagination.PageSize == 50)">50</option>

                </select>

                <input type="hidden" name="page" value="1" />

            </form>

        </div>
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>CIJ Number</th>
                            <th>Request Date</th>
                            <th>Approver Role</th>
                            <th>Assigned Date</th>
                            <th>Department</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.myApprovalViewModels.Any())
                        {
                            var index = 1;

                            foreach (var item in Model.myApprovalViewModels)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @item.CIJNumber
                                        </strong>
                                    </td>
                                    <td>
                                        @item.RequestDate?.ToString("dd-MMM-yyyy")
                                    </td>

                                    <td>
                                        @item.ApproverRole
                                    </td>
                                    <td>
                                        @item.AssignedDate?.ToString("dd-MMM-yyyy")
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.DepartmentName))
                                        {
                                            @item.DepartmentName
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.LocationName))
                                        {
                                            @item.LocationName
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.StatusName == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @item.StatusName
                                            </span>
                                        }
                                        else if (item.StatusName == "Query")
                                        {
                                            <span class="badge bg-info text-dark">
                                                @item.StatusName
                                            </span>
                                        }
                                        else if (item.StatusName == "Rejected")
                                        {
                                            <span class="badge bg-danger text-dark">
                                                @item.StatusName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary text-dark">
                                                @item.StatusName
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">

                                        <a asp-controller="WorkFlow"
                                           asp-action="ViewCIJRequest"
                                           asp-route-approvalId="@item.ApprovalId"
                                           asp-route-cijId="@item.CIJId"
                                           class="btn btn-sm btn-primary btn-edit" title="View CIJ">
                                            <i class="bi bi-eye me-1"></i>
                                        </a>
                                        @if (item.StatusName == "Pending" || (item.StatusName == "Query" && item.ClarificationUserType == "Target"))
                                        {
                                            <a asp-controller="WorkFlow"
                                               asp-action="ApprovalAction"
                                               asp-route-approvalId="@item.ApprovalId"
                                               asp-route-cijId="@item.CIJId"
                                               class="btn btn-sm btn-success btn-edit" title="Take Action">
                                                <i class="bi bi-check2-square me-1"></i>
                                            </a>
                                        }
                                        @if (item.ApproverRole == "Purchase")
                                        {
                                            <a asp-controller="GeneratePDF"
                                               asp-action="DownloadCIJPDF"
                                               asp-route-cijId="@item.CIJId"
                                               class="btn btn-sm btn-danger btn-edit" title="Download CIJ PDF">
                                                <i class="bi bi-file-earmark-pdf"></i>
                                            </a>
                                        }

                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center">
                                    <div class="text-muted">
                                        <h6>No pending approvals</h6>
                                        <small>
                                            You currently have no CIJ requests waiting for your approval.
                                        </small>
                                    </div>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
                <partial name="_Pagination" model="Model.Pagination" />
            </div>

        </div>

    </div>

</div>