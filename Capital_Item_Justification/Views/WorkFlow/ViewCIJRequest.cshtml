@model Capital_Item_Justification.ViewModels.ApprovalRequestDetailsViewModel

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-1">
                        <i class="bi bi-check2-square me-2"></i>
                        CIJ Approval Detail
                    </h3>
                    <small class="text-muted">
                        Review the CIJ request
                    </small>
                </div>

                <a class="btn btn-outline-secondary" onclick="history.back()">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to My Approval
                </a>
            </div>
        </div>
    </div>
    <!-- CIJ Summary -->
    <div class="card card-primary card-outline mb-3">
        <div class="card-header">
            <h3 class="card-title">
                <i class="bi bi-file-earmark-text me-2"></i>
                CIJ Request Information
            </h3>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="border rounded p-3 bg-light">

                        <div class="row mb-2">
                            <div class="col-sm-5 fw-bold">
                                CIJ Number
                            </div>
                            <div class="col-sm-7">
                                : @Model.CIJRequest.CIJSNumber
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-sm-5 fw-bold">
                                Request Date
                            </div>
                            <div class="col-sm-7">
                                : @Model.CIJRequest.RequestDate.ToString("dd-MMM-yyyy")
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-sm-5 fw-bold">
                                Requested Department
                            </div>
                            <div class="col-sm-7">
                                : @Model.CIJRequest.RequestDepartment
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-5 fw-bold">
                                Location
                            </div>
                            <div class="col-sm-7">
                                : @Model.CIJRequest.LocationName
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-5 fw-bold">
                                Cost Center
                            </div>
                            <div class="col-sm-7">
                                : @Model.CIJRequest.CostCenterName
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-5 fw-bold">
                                Budget Provision
                            </div>
                            <div class="col-sm-7">
                                : @Model.CIJRequest.BudgetProvision
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-5 fw-bold">
                                Equipment Cost
                            </div>
                            <div class="col-sm-7">
                                : ₹@(Model.CIJRequest.TotalEquipmentCost.HasValue
                                 ? Model.CIJRequest.TotalEquipmentCost.Value.ToString("N0")
                                 : "0")
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-5 fw-bold">
                                Benef Department
                            </div>
                            <div class="col-sm-6">
                                : @Model.CIJRequest.BeneficiaryDepartment
                            </div>
                        </div>
                    </div>
                </div>


                <div class="col-md-6">
                    <div class="border rounded p-3 bg-light">
                        <div class="row mb-2">
                            <div class="col-sm-5 fw-bold">
                                Project Fund
                            </div>
                            <div class="col-sm-7">
                                :  @Model.CIJRequest.ProjectFund
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-5 fw-bold">
                                Project Code
                            </div>
                            <div class="col-sm-7">
                                :  @Model.CIJRequest.ProjectCode
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-sm-5 fw-bold">
                                Requestor
                            </div>
                            <div class="col-sm-7">
                                :  @Model.CIJRequest.RequestorName
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-sm-5 fw-bold">
                                Item Type
                            </div>
                            <div class="col-sm-7">
                                :  @Model.CIJRequest.ItemTypeName
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-5 fw-bold">
                                Current Status
                            </div>
                            <div class="col-sm-7">
                                :
                                <span>
                                    @Model.CIJRequest.StatusName
                                </span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-5 fw-bold">
                                Project Cost
                            </div>
                            <div class="col-sm-7">
                                :
                                <span>
                                    ₹@(Model.CIJRequest.ProjectCost.HasValue
                                       ? Model.CIJRequest.ProjectCost.Value.ToString("N0")
                                       : "0")
                                </span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-5 fw-bold">
                                SCEH Cost
                            </div>
                            <div class="col-sm-7">
                                :
                                <span>
                                    ₹@(Model.CIJRequest.Scehcost.HasValue
                                       ? Model.CIJRequest.Scehcost.Value.ToString("N0")
                                       : "0")
                                </span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-5 fw-bold">
                                Beneficiary Location
                            </div>
                            <div class="col-sm-7">
                                : @Model.CIJRequest.BeneficiaryLocation
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Equipment Details -->
    <div class="card card-primary card-outline mb-3">
        <div class="card-header">
            <h3 class="card-title">
                <i class="bi bi-pc-display me-2"></i>
                Equipment Details
            </h3>
        </div>
        <div class="card-body">
            @if (Model != null)
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:50px;">#</th>
                                <th>Equipment Name</th>
                                <th>Manufacturer</th>
                                <th>Model</th>
                                <th>Quantity</th>
                                <th class="text-end">Estimated Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int equipmentIndex = 1;
                                decimal equipmentTotal = 0;
                            }
                            @foreach (var equipment in Model.cIJEquipmentViewModels)
                            {

                                <tr>
                                    <td>
                                        @equipmentIndex
                                    </td>
                                    <td>
                                        @equipment.EquipmentName
                                    </td>
                                    <td>
                                        @equipment.Make
                                    </td>
                                    <td>
                                        @equipment.Model
                                    </td>
                                    <td>
                                        @equipment.EquipmentQty
                                    </td>
                                    <td class="text-end">
                                        ₹@equipment.EquipmentCost.ToString("N0")
                                    </td>

                                </tr>

                                equipmentIndex++;
                                equipmentTotal += equipment.EquipmentCost;
                            }

                        </tbody>
                        <tfoot>
                            <tr class="table-light fw-bold">
                                <td colspan="5" class="text-end">
                                    Total Estimated Cost
                                </td>
                                <td class="text-end">
                                    ₹@equipmentTotal.ToString("N0")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No equipment details available.
                </div>
            }
        </div>
    </div>
    <!-- Justification -->
    <div class="card card-primary card-outline mb-3">
        <div class="card-header">
            <h3 class="card-title">
                <i class="bi bi-chat-left-text me-2"></i>
                Justification
            </h3>
        </div>
        <div class="card-body">
            @if (Model?.cIJJustificationViewModel != null)
            {
                <div class="row mb-3 align-items-center">
                    <label class="col-md-9 col-form-label fw-semibold">
                        (i) If it is new treatment / diagnostic provision calculation
                        (Number of Beneficiary) of Return on Investment (ROI)
                    </label>

                    <div class="col-md-3">
                        <div class="border rounded p-2 bg-light">
                            @(Model.cIJJustificationViewModel.Roinumber?.ToString() ?? "-")
                        </div>
                    </div>
                </div>

                <!-- Replacement of Old Asset -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        (ii) If it is replacement of old asset, old asset beyond repairs confirmation from Biomedical.
                        Biomedical shall confirm if there is spare equipment at any location in the network.
                    </label>
                </div>

                <!-- Addition to Capacity -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        (iii) If it is addition to capacity, number of patients/tests being done with earlier
                        equipment and current waiting period for patients.
                    </label>
                </div>

                <hr />

                <!-- Business Justification -->
                <div class="mb-2">
                    <label class="form-label fw-semibold">
                        Justification
                    </label>
                    <div class="border rounded p-2 bg-light" style="min-height:70px;">
                        @(string.IsNullOrWhiteSpace(Model.cIJJustificationViewModel.Justification) ? "-" : Model.cIJJustificationViewModel.Justification)
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No justification available.
                </div>
            }
        </div>
    </div>
    <!-- Remarks -->
    <div class="card card-primary card-outline mb-3">
        <div class="card-header">
            <h3 class="card-title">
                <i class="bi bi-chat-square-text me-2"></i>
                Remarks
            </h3>
        </div>
        <div class="card-body">
            @if (Model?.cIJEquipmentViewModels != null)
            {
                <div class="row">
                    <!-- Same Brand -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            Is the same brand as earlier purchased / available?
                        </label>

                        <div class="border rounded p-2 bg-light">
                            @if (Model.cIJJustificationViewModel.IsPurchasedEarlier == true)
                            {
                                <span class="badge bg-success">
                                    Yes
                                </span>
                            }
                            else if (Model.cIJJustificationViewModel.IsPurchasedEarlier == false)
                            {
                                <span class="badge bg-danger">
                                    No
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not specified
                                </span>
                            }
                        </div>
                    </div>

                </div>

                <div class="row">

                    @if (Model.cIJJustificationViewModel.IsPurchasedEarlier == false)
                    {
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">
                                Remarks
                            </label>

                            <div class="border rounded p-2 bg-light"
                                 style="min-height:70px;">
                                @(string.IsNullOrWhiteSpace(Model.cIJJustificationViewModel.Remarks) ? "-" : Model.cIJJustificationViewModel.Remarks)
                            </div>
                        </div>
                    }
                    @* @if (Model.CIJRequest.ItemTypeName == "Medical")
                {
                <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">
                Equipment Committee Comments
                </label>
                <div class="border rounded p-2 bg-light"
                style="min-height:70px;">
                @(string.IsNullOrWhiteSpace(Model.committeeCommentViewModel?.Comments) ? "-" : Model.committeeCommentViewModel.Comments)
                </div>
                </div>
                } *@
                </div>
            }
        </div>
    </div>
    <!-- Attachments -->
    <div class="card card-primary card-outline mb-3">

        <div class="card-header">
            <h3 class="card-title">
                <i class="bi bi-paperclip me-2"></i>
                Attachments
            </h3>
        </div>

        <div class="card-body">

            @if (Model != null)
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>File Name</th>
                                <th>Module name</th>
                                <th style="width:100px;">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var attachment in Model.attachmentViewModels)
                            {
                                <tr>
                                    <td>
                                        <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
                                        @attachment.FileName
                                    </td>
                                    <td>
                                        @attachment.ModuleName
                                    </td>
                                    <td align="center">
                                        <a title="Download" href="@Url.Action("DownloadAttachment", "CIJ", new { attachmentId = attachment.AttachmentId,cijId=attachment.Cijid })">
                                            <i class="bi bi-download"></i>
                                        </a>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No attachments available.
                </div>
            }

        </div>
    </div>
    <!-- Clarification History -->
    <div class="card card-primary card-outline mb-3">
        <div class="card-header">
            <h3 class="card-title">
                <i class="bi bi-clock-history me-2"></i>
                Clarification History
            </h3>
        </div>

        <div class="card-body">
            @if (Model?.Clarifications != null && Model.Clarifications.Any())
            {
                <div class="clarification-list">
                    @foreach (var item in Model.Clarifications)
                    {
                        <div class="clarification-item">

                            <!-- Query Details -->
                            <div class="clarification-section query-section">
                                <div class="section-heading">
                                    <i class="bi bi-chat-square-text me-2"></i>
                                    Query Details
                                </div>

                                <div class="clarification-info">
                                    <div class="info-item">
                                        <span class="info-label">Raised Date</span>
                                        <span class="info-value">
                                            @item.RaisedOn.ToString("dd-MMM-yyyy")
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Raised By</span>
                                        <span class="info-value">
                                            @(string.IsNullOrWhiteSpace(item.RaisedBy)
                                                ? "-"
                                                : item.RaisedBy)
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Role</span>
                                        <span class="info-value">
                                            @(string.IsNullOrWhiteSpace(item.RaisedByRole)
                                                ? "-"
                                                : item.RaisedByRole)
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Department</span>
                                        <span class="info-value">
                                            @(string.IsNullOrWhiteSpace(item.RaisedDepartment)
                                                ? "-"
                                                : item.RaisedDepartment)
                                        </span>
                                    </div>
                                </div>

                                <div class="detail-label">Query</div>
                                <div class="message-box">
                                    @(string.IsNullOrWhiteSpace(item.ClarificationPoint)
                                        ? "-"
                                        : item.ClarificationPoint)
                                </div>
                            </div>

                            <!-- Answer Details -->
                            <div class="clarification-section answer-section">
                                <div class="section-heading">
                                    <i class="bi bi-chat-left-text me-2"></i>
                                    Answer Details
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Answer))
                                {
                                    <div class="clarification-info">
                                        <div class="info-item">
                                            <span class="info-label">Answered Date</span>
                                            <span class="info-value">
                                                @* Replace with your actual answer date property *@
                                                @(
                                            item.AnsweredOn.HasValue
                                        ? item.AnsweredOn.Value.ToString("dd-MMM-yyyy")
                                        : "-"
                                            )
                                            </span>
                                        </div>

                                        <div class="info-item">
                                            <span class="info-label">Answered By</span>
                                            <span class="info-value">
                                                @(
                                            string.IsNullOrWhiteSpace(item.AnsweredBy)
                                        ? "-"
                                        : item.AnsweredBy
                                            )
                                            </span>
                                        </div>

                                        <div class="info-item">
                                            <span class="info-label">Role</span>
                                            <span class="info-value">
                                                @(
                                            string.IsNullOrWhiteSpace(item.AnsweredByRole)
                                        ? "-"
                                        : item.AnsweredByRole
                                            )
                                            </span>
                                        </div>

                                        <div class="info-item">
                                            <span class="info-label">Department</span>
                                            <span class="info-value">
                                                @(
                                            string.IsNullOrWhiteSpace(item.AnsweredDepartment)
                                        ? "-"
                                        : item.AnsweredDepartment
                                            )
                                            </span>
                                        </div>
                                    </div>
                                    <div class="detail-label">Answer</div>
                                    <div class="message-box">
                                        @(
                                    string.IsNullOrWhiteSpace(item.Answer)
                                        ? "Awaiting response."
                                        : item.Answer
                                    )
                                    </div>
                                }
                                else
                                {
                                    <div class="message-box">
                                        <span class="text-muted">
                                            Awaiting response.
                                        </span>
                                    </div>
                                }
                            </div>

                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No clarification history available.
                </div>
            }
        </div>
    </div>

    <div class="card card-primary card-outline mb-3">
        <div class="card-header">
            <h3 class="card-title">
                <i class="bi bi-clock-history me-2"></i>
                Approval History
            </h3>
        </div>
        <div class="card-body">
            @if (Model.workflowHistory != null && Model.workflowHistory.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle approval-history-table">
                        <thead class="table-light">
                            <tr>
                                <th>Approved Date</th>
                                <th>Approved By</th>
                                <th>Role</th>
                                <th>Department</th>
                                <th>Status</th>
                                <th class="remarks-column">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var history in Model.workflowHistory)
                            {
                                <tr>
                                    <td>
                                        @history.ActionDate.ToString("dd-MMM-yyyy")
                                    </td>
                                    <td>
                                        @history.UserName
                                    </td>
                                    <td>
                                        @history.RoleName
                                    </td>
                                    <td>
                                        @history.Departmentname
                                    </td>
                                    <td>
                                        @if (history.StatusName == "Submitted")
                                        {
                                            <span class="badge bg-primary">
                                                @history.StatusName
                                            </span>
                                        }
                                        else if (history.StatusName == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                @history.StatusName
                                            </span>
                                        }
                                        else if (history.StatusName == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                @history.StatusName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">
                                                @history.StatusName
                                            </span>
                                        }
                                    </td>
                                    <td class="remarks-column">
                                        @history.Remark
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No approval history available.
                </div>
            }

        </div>
    </div>

    <div class="row button-margin">
        <div class="d-flex justify-content-end gap-2 ">
            <a class="btn btn-secondary" onclick="history.back()">
                <i class="bi bi-x-circle me-1"></i>
                Cancel
            </a>
        </div>
    </div>
</div>

<style type="text/css">
.clarification-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.clarification-item {
    border: 1px solid #dee2e6;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
}

.clarification-section {
    padding: 16px;
}

.query-section {
    background: #f1f6ff;
    border-bottom: 1px solid #dee2e6;
}

.answer-section {
    background: #fff;
}

.section-heading {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 16px;
    color: #0d6efd;
}

.answer-section .section-heading {
    color: #198754;
}

/* Metadata layout */
.clarification-info {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 16px;
}

.info-item {
    min-width: 0;
}

.info-label {
    font-weight: 500;
}

.info-value {
    display: block;
    font-size: 14px;
    overflow-wrap: anywhere;
}

.detail-label {
    font-size: 13px;
    font-weight: 600;
    color: #495057;
    margin-bottom: 7px;
}

/* Query and answer content */
.message-box {
    border: 1px solid #dee2e6;
    border-radius: 6px;
    padding: 12px;
    background: #fff;
    color: #343a40;
    line-height: 1.6;
    overflow-wrap: anywhere;
    min-height: 50px;
}

.answer-section .message-box {
    background: #f8f9fa;
}

.answer-status {
    margin-top: 12px;
    text-align: right;
}

.approval-history-table {
    width: 100%;
    table-layout: fixed;
}

.approval-history-table th,
.approval-history-table td {
    vertical-align: top;
    white-space: normal;
}

.approval-history-table th.remarks-column,
.approval-history-table td.remarks-column {
    width: 30%;
    overflow-wrap: anywhere;
}
</style>
