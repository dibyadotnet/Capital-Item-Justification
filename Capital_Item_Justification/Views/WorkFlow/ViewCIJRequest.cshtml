    <div class="row button-margin">
        <div class="d-flex justify-content-end gap-2 ">
            <a class="btn btn-secondary" onclick="history.back()">
                <i class="bi bi-x-circle me-1"></i>
                Cancel
            </a>
        </div>
    </div>
</div>
