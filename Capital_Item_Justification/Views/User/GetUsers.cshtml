@model Capital_Item_Justification.ViewModels.UserListViewModel

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h4>
            <i class="bi bi-people"></i>
            User Master
        </h4>

        <a asp-action="CreateUser"
           class="btn btn-primary">

            <i class="bi bi-plus-circle"></i>
            Add User

        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-controller="User" asp-action="GetUsers" method="get">
                <div class="row g-3 align-items-end mb-2">
                    <!-- CIJ Number -->
                    <div class="col-md-3">
                        <label for="departmentId" class="form-label fw-semibold">
                            Department
                        </label>
                        <select id="DepartmentId" name="departmentId" class="form-select" asp-items="ViewBag.DepartmentList">
                            <option value="">-- Select --</option>
                        </select>
                    </div>
                    <!-- Status -->
                    <div class="col-md-3">
                        <label for="LocationId" class="form-label fw-semibold">
                            Location
                        </label>
                        <select id="LocationId" name="locationId" class="form-select" asp-items="ViewBag.LocationList">
                            <option value="">-- Select --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="RoleId" class="form-label fw-semibold">
                            Role
                        </label>
                        <select id="RoleId" name="roleId" class="form-select" asp-items="ViewBag.RoleList">
                            <option value="">-- Select --</option>
                        </select>
                    </div>
                    <!-- Buttons -->
                    <div class="col-md-3">

                        <button type="submit"
                                class="btn btn-primary me-2">
                            <i class="bi bi-search me-1"></i>
                            Search
                        </button>

                        <a asp-action="GetUsers"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-clockwise me-1"></i>
                            Reset
                        </a>

                    </div>
                </div>
            </form>

            <div class="table-responsive">
                <div class="d-flex justify-content-end mb-3">

                    <form asp-action="GetUsers"
                          method="get"
                          class="d-flex align-items-center gap-2">

                        <label class="mb-0">
                            Show:
                        </label>

                        <select name="pageSize"
                                class="form-select form-select-sm"
                                style="width:80px;"
                                onchange="this.form.submit()">

                            <option value="10"
                                    selected="@(Model.Pagination.PageSize == 10)">
                                10
                            </option>

                            <option value="25"
                                    selected="@(Model.Pagination.PageSize == 25)">
                                25
                            </option>

                            <option value="50"
                                    selected="@(Model.Pagination.PageSize == 50)">
                                50
                            </option>

                        </select>

                        <span class="text-muted">
                            entries
                        </span>

                        <input type="hidden"
                               name="page"
                               value="1" />

                    </form>

                </div>
                <table class="table table-bordered table-hover">

                    <thead class="table-light">

                        <tr>
                            <th>Employee Code</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th>Role</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th width="150">Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var user in Model.Users)
                        {
                            <tr>                            
                                <td>
                                    @user.EmployeeCode
                                </td>
                                <td>
                                    @user.FullName
                                </td>
                                <td>
                                    @user.Email
                                </td>
                                <td>
                                    @user.DepartmentName
                                </td>
                                <td>
                                    @user.RoleName
                                </td>
                                <td>
                                    @user.LocationName
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (user.IsActive)
                                    {
                                        <a asp-action="EditUser" title="Edit User"
                                        asp-route-id="@user.Id"
                                        class="btn btn-sm btn-primary btn-edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    <form asp-action="ToggleStatus" onsubmit="return confirm('Are you sure you want to change this User status?');"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@user.Id" />

                                        <button type="submit" title="Manage Status"
                                                class="btn btn-sm btn-warning btn-edit">
                                            <i class="bi bi-toggle-on"></i>

                                        </button>

                                    </form>
                                    @if(user.IsActive){
                                    <a asp-action="ManageRoles"
                                       asp-route-id="@user.Id"
                                           class="btn btn-sm btn-success btn-edit"
                                       title="Manage Roles">

                                        <i class="bi bi-person-check"></i>

                                    </a>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
                <partial name="_Pagination" model="Model.Pagination" />
            </div>

        </div>

    </div>
</div>
