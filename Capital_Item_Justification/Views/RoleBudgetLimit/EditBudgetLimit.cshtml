@model Capital_Item_Justification.ViewModels.RoleBudgetLimitViewModel


<div class="card">

    <div class="card-header">
        <h5>
            <i class="bi bi-currency-rupee"></i>
            Edit Role Budget Limit
        </h5>
    </div>

    <form asp-action="Edit" method="post">

        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="RoleBudgetLimitId" />

        <div class="card-body">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row">
              
                    <div class="col-md-6 mb-3">
                        <input type="hidden" asp-for="RoleId" />
                        <label asp-for="RoleId" class="form-label">
                            Role <span class="text-danger">*</span>
                        </label>
                        <select asp-for="RoleId" class="form-select" disabled>
                            <option value=""> -- Select Role -- </option>
                            @foreach (var role in ViewBag.Roles)
                            {
                                <option value="@role.Id">
                                    @role.Name
                                </option>
                            }
                        </select>
                    </div>
               
                <div class="col-md-6 mb-3">

                    <label asp-for="BudgetLimit" class="form-label">
                        Budget Limit <span class="text-danger">*</span>
                    </label>

                    <input asp-for="BudgetLimit"
                           type="number"
                           class="form-control"
                           placeholder="Enter budget limit" value="@(Model.BudgetLimit.ToString("N0", new System.Globalization.CultureInfo("en-IN")))" />

                    <span asp-validation-for="BudgetLimit"
                          class="text-danger">
                    </span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Item Type</label>
                    <select asp-for="ItemTypeId" asp-items="Model.ItemTypes" class="form-select">
                        <option value="">-- Select Item Type --</option>
                    </select>
                </div>

            </div>

        </div>

        <div class="card-footer text-end">

            <a asp-action="GeRoleBudgetLimit"
               class="btn btn-secondary">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-primary">
                <i class="bi bi-save"></i>
                Update
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // Prevent decimal, negative, and scientific notation input
            $(document).on('keydown', '#BudgetLimit', function (e) {
                if (['.', ',', 'e', 'E', '-', '+'].includes(e.key)) {
                    e.preventDefault();
                }
            });

            // Prevent decimal values entered through paste or other methods
            $(document).on('input', '#BudgetLimit', function () {
                let value = this.value;

                if (value.includes('.')) {
                    this.value = value.split('.')[0];
                }
            });

        });
    </script>

    <partial name="_ValidationScriptsPartial" />
}