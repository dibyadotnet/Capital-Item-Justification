@model Capital_Item_Justification.ViewModels.RoleBudgetLimitViewModel

@{
    ViewData["Title"] = "Add Role Budget Limit";
}

<div class="card">

    <div class="card-header">
        <h3 class="card-title">
            Add Role Budget Limit
        </h3>
    </div>

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="RoleBudgetLimitId" />

        <div class="card-body">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="RoleId" class="form-label">
                        Role <span class="text-danger">*</span>
                    </label>
                    <select asp-for="RoleId" class="form-select">
                        <option value=""> -- Select Role -- </option>
                        @foreach (var role in ViewBag.Roles)
                        {
                            <option value="@role.Id">
                                @role.Name
                            </option>
                        }
                    </select>

                    <span asp-validation-for="RoleId" class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="BudgetLimit" class="form-label">
                        Budget Limit <span class="text-danger">*</span>
                    </label>

                    <input asp-for="BudgetLimit"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           placeholder="Enter budget limit" />

                    <span asp-validation-for="BudgetLimit"
                          class="text-danger">
                    </span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Item Type</label>
                    <select asp-for="ItemTypeId" asp-items="Model.ItemTypes" class="form-select">
                        <option value="">-- Select Item Type --</option>
                    </select>
                </div>
               @*  <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Status
                    </label>

                    <div class="form-check form-switch">

                        <input asp-for="IsActive"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="IsActive"
                               class="form-check-label">
                            Active
                        </label>

                    </div>

                </div> *@

            </div>

        </div>

        <div class="card-footer text-end">

            <a asp-action="GeRoleBudgetLimit"
               class="btn btn-secondary">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-primary">
                <i class="bi bi-save"></i>
                Save
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}