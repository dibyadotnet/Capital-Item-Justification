@model IEnumerable<Capital_Item_Justification.ViewModels.DepartmentViewModel>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>
            <i class="bi bi-people"></i>
            Department Master
        </h4>
        <a asp-action="AddDepartment" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Department
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th class="d-none"></th>
                            <th>Department Name</th>
                            <th width="150">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="d-none">@item.DepartmentId</td>
                                <td>
                                    @item.DepartmentName
                                </td>
                                <td>
                                    <a asp-action="EditDepartment" title="Edit Department" asp-route-id="@item.DepartmentId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteDepartment" onsubmit="return confirm('Are you sure you want to delete this Department?');" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.DepartmentId" />

                                        <button type="submit" title="Delete Department" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

