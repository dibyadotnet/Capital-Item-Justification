@model Capital_Item_Justification.ViewModels.SelectRoleViewModel

<div class="role-page">
    <div class="role-card">

        <div class="text-center mb-4">
            <h5 class="fw-bold mb-1">CIJ Management System</h5>
            <p>Capital Item Justification</p>
        </div>

        <div class="role-info mb-4">
            <i class="bi bi-person-check-fill"></i>
            <div>
                <strong>Select your working role</strong>
                <div class="small">
                    You have multiple roles assigned to your account.
                    Select the role you want to work with.
                </div>
            </div>
        </div>

        <form asp-controller="Account"
              asp-action="SelectRole"
              method="post"
              id="roleForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger small mb-3"></div>

            <div class="role-list">
                @foreach (var role in Model.Roles)
                {
                    var selected =
                    Model.AssignmentId == role.AssignmentId;

                    <label class="role-option @(selected ? "selected" : "")"
                           for="role_@role.AssignmentId">

                        <input type="radio"
                               asp-for="AssignmentId"
                               id="role_@role.AssignmentId"
                               value="@role.AssignmentId"
                               class="role-radio" />

                        <span class="role-icon">
                            <i class="bi bi-person-badge"></i>
                        </span>

                        <span class="role-details">
                            <span class="role-name">
                                @role.RoleName
                            </span>

                            <span class="role-meta">
                                <i class="bi bi-building"></i>
                                @role.DepartmentName
                            </span>

                            <span class="role-meta">
                                <i class="bi bi-geo-alt"></i>
                                @role.LocationName
                            </span>
                        </span>

                        <span class="role-check">
                            <i class="bi bi-check-circle-fill"></i>
                        </span>
                    </label>
                }
            </div>

            <span asp-validation-for="AssignmentId"
                  class="text-danger small"></span>

            <button type="submit"
                    id="continueButton"
                    class="btn btn-danger w-100 mt-4">
                <span id="buttonText">
                    Continue
                    <i class="bi bi-arrow-right ms-2"></i>
                </span>
                <span id="buttonSpinner"
                      class="d-none">
                    <span class="spinner-border spinner-border-sm me-2"
                          role="status"></span>
                    Please wait...
                </span>
            </button>
        </form>
    </div>
</div>

@section Styles {
    <style>
        .role-page {
            min-height: calc(100vh - 100px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px 15px;
            background: #f4f6f9;
        }

        .role-card {
            width: 100%;
            max-width: 600px;
            padding: 32px;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        }

        .role-info {
            display: flex;
            gap: 14px;
            align-items: center;
            padding: 16px;
            background: #fff0f0;
            border: 1px solid #f8d7da;
            border-radius: 8px;
        }

            .role-info > i {
                color: #d71920;
                font-size: 27px;
            }

        .role-option {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px;
            margin-bottom: 12px;
            border: 1px solid #dce1e7;
            border-radius: 9px;
            cursor: pointer;
            transition: border-color .2s, background .2s;
        }

            .role-option:hover {
                border-color: #d71920;
                background: #fffafa;
            }

            .role-option.selected {
                border: 1.5px solid #d71920;
                background: #fff3f3;
            }

        .role-radio {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
            accent-color: #d71920;
        }

        .role-icon {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #d71920;
            background: #fde7e8;
            border-radius: 8px;
            font-size: 22px;
        }

        .role-details {
            display: flex;
            flex: 1;
            min-width: 0;
            flex-direction: column;
            gap: 4px;
        }

        .role-name {
            font-weight: 600;
            color: #202b38;
            overflow-wrap: anywhere;
        }

        .role-meta {
            color: #647080;
            font-size: 13px;
            overflow-wrap: anywhere;
        }

            .role-meta i {
                margin-right: 5px;
            }

        .role-check {
            color: #d71920;
            font-size: 20px;
            visibility: hidden;
        }

        .role-option.selected .role-check {
            visibility: visible;
        }

        #continueButton {
            padding: 12px;
            background: #d71920;
            border-color: #d71920;
            font-weight: 600;
        }

            #continueButton:hover {
                background: #b9151b;
                border-color: #b9151b;
            }

        @@media (max-width: 576px) {
            .role-card {
                padding: 22px 16px;
            }

            .role-option {
                gap: 10px;
                padding: 12px;
            }
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            function updateSelectedRole() {
                $('.role-option').removeClass('selected');

                $('input[name="AssignmentId"]:checked')
                    .closest('.role-option')
                    .addClass('selected');
            }

            $('input[name="AssignmentId"]').on('change',
                updateSelectedRole);

            updateSelectedRole();

            $('#roleForm').on('submit', function () {
                if (!$(this).valid()) {
                    return;
                }

                $('#continueButton').prop('disabled', true);
                $('#buttonText').addClass('d-none');
                $('#buttonSpinner').removeClass('d-none');
            });
        });
    </script>
}
