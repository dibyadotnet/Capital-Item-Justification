@model Capital_Item_Justification.ViewModels.TotalCountDashboardViewModel
<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>
            <i class="bi bi-speedometer2"></i>
            CIJ Dashboard
        </h4>
    </div>

    <div class="row g-3">

        @if (ViewBag.Roles.Contains("Requester"))
        {
            <div class="col-lg-3 col-md-6">
                <div class="card dashboard-card dashboard-total shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Total CIJ Requests</h6>
                                <a asp-controller="WorkFlow"
                                   asp-action="TrackRequest"
                                   class="text-decoration-none text-dark">
                                    <h2 class="fw-bold mb-0">@Model.TotalRequests</h2>
                                </a>
                            </div>
                            <i class="bi bi-file-earmark-text fs-1 text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Draft -->
            <div class="col-lg-3 col-md-6">
                <div class="card dashboard-card dashboard-draft shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Draft</h6>
                                <a asp-controller="CIJ"
                                   asp-action="MyRequests"
                                   class="text-decoration-none text-dark">
                                    <h2 class="fw-bold mb-0">@Model.DraftCount</h2>
                                </a>
                            </div>
                            <i class="bi bi-file-earmark fs-1 text-secondary"></i>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Pending -->
        @if (ViewBag.Roles.Contains("Requester"))
        {
            <div class="col-lg-3 col-md-6">
                <div class="card dashboard-card dashboard-pending shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Pending Approval</h6>
                            <a asp-controller="WorkFlow"
                               asp-action="TrackRequest" asp-route-statusId="@Model.PendingStatusId"
                               class="text-decoration-none text-dark">
                                <h2 class="fw-bold mb-0">@Model.PendingCount</h2>
                            </a>
                        </div>
                        <i class="bi bi-hourglass-split fs-1 text-warning"></i>
                    </div>
                </div>
            </div>
            </div>
        }
        else
        {
            <div class="col-lg-3 col-md-6">
                <div class="card dashboard-card dashboard-pending shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Pending Approval</h6>
                                <a asp-controller="WorkFlow"
                                   asp-action="MyApproval"
                                   class="text-decoration-none text-dark">
                                    <h2 class="fw-bold mb-0">@Model.PendingCount</h2>
                                </a>
                            </div>
                            <i class="bi bi-hourglass-split fs-1 text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (!ViewBag.Roles.Contains("Requester") && !ViewBag.Roles.Contains("Purchase"))
        {
            <div class="col-lg-3 col-md-6">
                <div class="card dashboard-card dashboard-query shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Query</h6>

                                <a asp-controller="WorkFlow"
                                   asp-action="MyApproval"
                                   class="text-decoration-none text-dark">

                                    <h2 class="fw-bold mb-0">
                                        @Model.QueryCount
                                    </h2>

                                </a>
                            </div>

                            <i class="bi bi-question-circle fs-1 dashboard-query-icon"></i>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (ViewBag.Roles.Contains("Requester") || ViewBag.Roles.Contains("Purchase"))
        {
            <!-- Rejected -->
            <div class="col-lg-3 col-md-6">
                <div class="card dashboard-card dashboard-rejected shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Rejected</h6>
                                @if (ViewBag.Roles.Contains("Purchase"))
                                {
                                    <a asp-controller="WorkFlow"
                                       asp-action="MyApproval"
                                       class="text-decoration-none text-dark">
                                        <h2 class="fw-bold mb-0">
                                            @Model.RejectedCount
                                        </h2>
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="WorkFlow"
                                       asp-action="TrackRequest"
                                       asp-route-statusId="@Model.RejectedStatusId"
                                       class="text-decoration-none text-dark">
                                        <h2 class="fw-bold mb-0">
                                            @Model.RejectedCount
                                        </h2>
                                    </a>
                                }
                            </div>
                            <i class="bi bi-x-circle fs-1 text-danger"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Completed -->
            <div class="col-lg-3 col-md-6">
                <div class="card dashboard-card dashboard-completed shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Completed</h6>
                                @if (ViewBag.Roles.Contains("Purchase"))
                                {
                                    <a asp-controller="WorkFlow"
                                       asp-action="CompletedApproval"
                                       class="text-decoration-none text-dark">
                                        <h2 class="fw-bold mb-0">
                                            @Model.CompletedCount
                                        </h2>
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="WorkFlow"
                                       asp-action="TrackRequest"
                                       asp-route-statusId="@Model.CompletedStatusId"
                                       class="text-decoration-none text-dark">
                                        <h2 class="fw-bold mb-0">
                                            @Model.CompletedCount
                                        </h2>
                                    </a>
                                }
                            </div>
                            <i class="bi bi-check2-all fs-1 text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        }



    </div>

</div>