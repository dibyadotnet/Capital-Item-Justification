
@model Capital_Item_Justification.ViewModels.TotalCountDashboardViewModel

@{
    var workingRoleName = Context.Session.GetString("WorkingRoleName");
}

<div class="container-fluid dashboard-container">

    <!-- Dashboard Heading -->
    <div class="d-flex justify-content-between align-items-center mb-4 dashboard-heading">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-speedometer2 me-2"></i>
                CIJ Dashboard
            </h4>
            <small class="text-muted">
                Overview of your CIJ activities and requests
            </small>
        </div>
    </div>

    <div class="row g-3">

        <!-- TOTAL CIJ REQUESTS -->
        @if (workingRoleName == "Requester")
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <a asp-controller="WorkFlow"
                   asp-action="TrackRequest"
                   class="dashboard-card-link">

                    <div class="card dashboard-card dashboard-total h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h6 class="dashboard-label">
                                        Total CIJ Requests
                                    </h6>

                                    <h2 class="dashboard-count">
                                        @Model.TotalRequests
                                    </h2>
                                </div>

                                <div class="dashboard-icon-box">
                                    <i class="bi bi-file-earmark-text"></i>
                                </div>

                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <!-- DRAFT -->
            <div class="col-xl-3 col-lg-4 col-md-6">
                <a asp-controller="CIJ"
                   asp-action="MyRequests"
                   class="dashboard-card-link">

                    <div class="card dashboard-card dashboard-draft h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h6 class="dashboard-label">
                                        Draft
                                    </h6>

                                    <h2 class="dashboard-count">
                                        @Model.DraftCount
                                    </h2>
                                </div>

                                <div class="dashboard-icon-box">
                                    <i class="bi bi-file-earmark"></i>
                                </div>

                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- PENDING APPROVAL -->
        @if (workingRoleName != "Requester")
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <a asp-controller="WorkFlow"
                   asp-action="MyApproval"
                   class="dashboard-card-link">

                    <div class="card dashboard-card dashboard-pending h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h6 class="dashboard-label">
                                        Pending Approval
                                    </h6>

                                    <h2 class="dashboard-count">
                                        @Model.PendingCount
                                    </h2>
                                </div>

                                <div class="dashboard-icon-box">
                                    <i class="bi bi-hourglass-split"></i>
                                </div>

                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- QUERY -->
        @if (workingRoleName != "Requester" &&
             workingRoleName != "Purchase")
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <a asp-controller="WorkFlow"
                   asp-action="MyApproval"
                   class="dashboard-card-link">

                    <div class="card dashboard-card dashboard-query h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h6 class="dashboard-label">
                                        Query
                                    </h6>

                                    <h2 class="dashboard-count">
                                        @Model.QueryCount
                                    </h2>
                                </div>

                                <div class="dashboard-icon-box">
                                    <i class="bi bi-question-circle"></i>
                                </div>

                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- REJECTED AND COMPLETED -->
        @if (workingRoleName == "Requester" ||
        workingRoleName == "Purchase" || workingRoleName == "Admin")
        {
            <!-- REJECTED -->
            if (workingRoleName == "Requester"){
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <a asp-controller="WorkFlow"
                           asp-action="TrackRequest"
                           asp-route-statusId="@Model.RejectedStatusId"
                           class="dashboard-card-link">

                            <div class="card dashboard-card dashboard-rejected h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">

                                        <div>
                                            <h6 class="dashboard-label">
                                                Rejected
                                            </h6>

                                            <h2 class="dashboard-count">
                                                @Model.RejectedCount
                                            </h2>
                                        </div>

                                        <div class="dashboard-icon-box">
                                            <i class="bi bi-x-circle"></i>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </a>
                </div>
            }
            <!-- COMPLETED -->
            <div class="col-xl-3 col-lg-4 col-md-6">
                <a asp-controller="WorkFlow"
                       asp-action="CompletedApproval"
                       class="dashboard-card-link">

                        <div class="card dashboard-card dashboard-completed h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">

                                    <div>
                                        <h6 class="dashboard-label">
                                            Completed
                                        </h6>

                                        <h2 class="dashboard-count">
                                            @Model.CompletedCount
                                        </h2>
                                    </div>

                                    <div class="dashboard-icon-box">
                                        <i class="bi bi-check2-all"></i>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </a>
            </div>
        }

    </div>
</div>
