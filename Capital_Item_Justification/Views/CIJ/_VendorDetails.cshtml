@{
}
<div class="card shadow-sm border-0 rounded-2 mt-1">
    <div class="card-body p-2">
        <h5 class="text-primary fw-bold mb-2">
             Vendor Quotations
        </h5>
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle" id="tblVendor">
                <thead class="table-light">
                    <tr>
                        <th width="60">#</th>
                        <th>Vendor Name</th>
                        <th width="170">Quoted Amount</th>
                        <th width="150">Quotation Date</th>
                        <th>Attachment</th>
                        <th width="120" class="text-center"> Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="6" class="text-center text-muted py-2">
                            No vendor quotation added.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-end mt-2">
            <button type="button" id="btnAddVendor" class="btn btn-success" data-bs-toggle="tooltip" data-bs-placement="top" title="Add Vendor Quotation">
                <i class="bi bi-plus-lg"></i>
            </button>
        </div>

    </div>

</div>
