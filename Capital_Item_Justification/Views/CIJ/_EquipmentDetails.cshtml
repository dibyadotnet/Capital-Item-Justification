@model IEnumerable<Capital_Item_Justification.ViewModels.CIJEquipmentViewModel>

<div class="card shadow-sm border-0 rounded-2 mt-1">
    <div class="card-body p-2">
        <h5 class="text-primary fw-bold mb-2">
            Equipment Details
        </h5>
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover table-sm" id="tblEquipment" width="100%">
                <thead>
                    <tr>
                        <th width="60">#</th>
                        <th>Equipment Name</th>
                        <th>Qty</th>
                        <th>Manufacturer</th>
                        <th>Model</th>
                        <th>Estimated Cost</th>
                        <th width="120" class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model !=null && Model.Count() > 0)
                    {
                        int i = 0;
                        {
                            i = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@item.EquipmentName</td>
                                <td>@item.EquipmentQty</td>
                                <td>@item.Make</td>
                                <td>@item.Model</td>
                                <td>@item.EquipmentCost</td>
                                <td>
                                    <button class="btn btn-sm btn-warning">Edit</button>
                                    <button class="btn btn-sm btn-danger">Delete</button>
                                </td>
                            </tr>

                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-2">
                                No equipment added.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="equipment-footer">
            <button type="button" class="btn btn-primary" id="btnAddEquipment" data-bs-toggle="modal" data-bs-target="#equipmentModal">
                Add Equipment
            </button>
            <div class="equipment-total">
                <span>Total Estimated Equipment Cost</span>
                <input type="text" id="TotalEquipmentCost" class="form-control" value="₹ 0.00" readonly />
            </div>
        </div>
    </div>
</div>
@{
    var equipment = new Capital_Item_Justification.ViewModels.CIJEquipmentViewModel();
}
@await Html.PartialAsync("_AddEquipment", equipment)
                        



