@model List<Capital_Item_Justification.ViewModels.CIJEquipmentViewModel>

<div class="card shadow-sm border-0 rounded-2 mt-1">
    <div class="card-body p-2">
        <h5 class="text-primary fw-bold mb-2">
            Equipment Details
        </h5>
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover table-sm" id="tblEquipment" width="100%">
                <thead>
                    <tr>
                        <th class="d-none"></th>
                        <th class="d-none"></th>
                        <th width="60">#</th>
                        <th>Equipment Name</th>
                        <th>Qty</th>
                        <th>Manufacturer</th>
                        <th>Model</th>
                        <th>Estimated Cost</th>
                        <th>Doc Pref</th>
                        <th width="120" class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model !=null && Model.Count() > 0)
                    {                      

                        @for (int i = 0; i < Model.Count(); i++)
                        {
                            <tr>
                                <td class="d-none">@Model[i].EquipmentId</td>
                                <td class="d-none">@Model[i].Cijid</td>
                                <td>@(i + 1)</td>
                                <td>@Model[i].EquipmentName</td>
                                <td>@Model[i].EquipmentQty</td>
                                <td>@Model[i].Make</td>
                                <td>@Model[i].Model</td>
                                <td>@Model[i].EquipmentCost</td>
                                <td>@Model[i].PreferenceOrder</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-warning me-1" onclick="EditEquipment(@i)">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger" onclick="DeleteEquipment(@i)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-2">
                                No equipment added.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="equipment-footer">
            <button type="button" class="btn btn-primary btn-addEqup" id="btnAddEquipment" data-bs-toggle="modal" data-bs-target="#equipmentModal">
                Add Equipment
            </button>
            <div class="equipment-total">
                <span>Total Estimated Equipment Cost</span>
                <input type="text" id="TotalEstEquipmentCost" class="form-control" value="@(ViewBag.TotalEstEquipmentCost ?? "₹ 0.00")" readonly />
            </div>
        </div>
    </div>
</div>
@{
    var equipment = new Capital_Item_Justification.ViewModels.CIJEquipmentViewModel();
}
@await Html.PartialAsync("_AddEquipment", equipment)
                        



