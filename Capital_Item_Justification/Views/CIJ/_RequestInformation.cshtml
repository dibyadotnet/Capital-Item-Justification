@{
    @model Capital_Item_Justification.ViewModels.CIJRequestViewModel
    ViewData.TemplateInfo.HtmlFieldPrefix = "CIJRequest";
}
<div class="card shadow-sm border-0 rounded-2 mt-1">
    <div class="card-body p-2">
        <h5 class="text-primary fw-bold mb-2">
            Request Information
        </h5>
        <input type="hidden" id="cijId" asp-for="Cijid" />
        <div class="row">
            <div class="col">
                <label class="form-label">Serial.NO</label>
                <input asp-for="CIJSNumber" class="form-control" readonly />
            </div>
            <div class="col">
                <label asp-for="RequestDate" class="form-label fw-semibold">Request Date</label>
                <input asp-for="RequestDate" type="date" class="form-control" readonly />
            </div>
            <div class="col">
                <label class="form-label">Cost Center</label>
                <select asp-for="CostCenterId" asp-items="Model.Locations" class="form-select">
                    <option value="">-- Select --</option>
                </select>
            </div>
            <div class="col">
                <label class="form-label">Project Code</label>
                <select asp-for="ProjectId" asp-items="Model.ProjectList" class="form-select">
                    <option value="">-- Select --</option>
                </select>
            </div>
        </div>
        <div class="row g-4">
            <div class="col">
                <label class="form-label">Budget Provision</label>
                <select asp-for="BudgetProvision" asp-items="Model.BudgetProvisionList" class="form-select">
                    <option value="">-- Select --</option>
                </select>
            </div>
            <div class="col">
                <label class="form-label fw-semibold">Budget Amount</label>
                <input asp-for="BudgetAmount" class="form-control" />
            </div>
            <div class="col">
                <label class="form-label fw-semibold">Item Type</label>
                <select asp-for="ItemtypeId" asp-items="Model.ItemTypes" class="form-select" id="ddlItemType">
                    <option value="">-- Select Item Type --</option>
                </select>
            </div>
            <div class="col">
                <label class="form-label fw-semibold">Eqiupment Cost</label>
                <input asp-for="TotalEquipmentCostDisplay" class="form-control" readonly />
                <input asp-for="TotalEquipmentCost" type="hidden" />
            </div>
           
        </div>

        <div class="row g-4">
            <div class="col">
                <label class="form-label fw-semibold">Project Cost</label>
                <input asp-for="ProjectCost" class="form-control" />
            </div>
            <div class="col">
                <label class="form-label fw-semibold">SCEH Cost</label>
                <input asp-for="Scehcost" class="form-control" />
            </div>
            <div class="col">
                <label class="form-label fw-semibold">Purpose of Purchase</label>
                <select asp-for="PurchasePurposeId" asp-items="Model.PurchagePurposeList" class="form-select">
                    <option value="">-- Select Purpose --</option>
                </select>
            </div>
            <div class="col">
                <label class="form-label fw-semibold">Old Equipment Treatment</label>
                <select asp-for="OldEquipmentTreatmentId" asp-items="Model.OldEqupTreatmentList" class="form-select">
                    <option value="">-- Select Treatment --</option>
                </select>
            </div>
            
        </div>
        <div class="row g-4">
            <div class="col">
                <label class="form-label fw-semibold">Old Equipment Cost</label>
                <input asp-for="OldEquipmentCost" class="form-control" />
            </div>
            <div class="col">
                <label class="form-label fw-semibold">Beneficiary Dept</label>
                <select asp-for="BeneficiaryDepartmentId" asp-items="Model.Departments" class="form-select">
                    <option value="">-- Select --</option>
                </select>
            </div>
            <div class="col">
                <label class="form-label fw-semibold">Beneficiary Location</label>
                <select asp-for="BeneficiaryLocationId" asp-items="Model.Locations" class="form-select">
                    <option value="">-- Select --</option>
                </select>
            </div>
            <div class="col">
                <label class="form-label fw-semibold">Waiting period</label>
                <input asp-for="WaitingPeriod" class="form-control" />
            </div>
        </div>

    </div>
</div>