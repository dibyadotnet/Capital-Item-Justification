<div class="card shadow-sm border-0 rounded-2 mt-1">
    <div class="card-body p-4">
        <h5 class="text-primary fw-bold mb-2"> Remarks </h5>
        <div class="row">
            <div class="col-md-6 mb-2">
                <label class="form-label fw-semibold required">
                    Is the same brand as earlier purchased / available?
                </label>
                <div class="mt-2">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" value="true" id="rbYes">
                        <label class="form-check-label" for="rbYes">Yes</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" value="false" id="rbNo">
                        <label class="form-check-label" for="rbNo">No </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6" id="brandRemarkSection">
            <label class="form-label fw-semibold"> Remarks</label>
                <textarea rows="5" class="form-control custom-textarea" placeholder="Enter detailed remarks..."></textarea>
        </div>
            <div class="col-md-6" id="brandRemarkSection">
            <label class="form-label fw-semibold">Comments</label>
                <textarea rows="5" class="form-control custom-textarea" placeholder="Enter detailed comments..."></textarea>
        </div>
        </div>
    </div>

</div>