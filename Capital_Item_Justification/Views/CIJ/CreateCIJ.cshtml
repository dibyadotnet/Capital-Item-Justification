@model Capital_Item_Justification.ViewModels.CIJMainViewModel

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center">
        <h5>Create Capital Item Justification</h5>
    </div>
    <form id="cijForm" asp-action="SaveCIJ" asp-controller="CIJ" method="post" enctype="multipart/form-data">
        <input type="hidden" id="EquipmentJson" name="EquipmentJson" value="@Model.EquipmentJson" />
        <partial name="_RequestInformation" model="Model.CIJRequest" />
        <partial name="_EquipmentDetails" model="Model.Equipments" />
        <partial name="_JustificationDetails" model="Model" />
        <partial name="_RemarksDetails" model="Model" />
        <partial name="_Attachments" model="Model" />

        <div class="d-flex justify-content-end gap-1">
            @if (Model.CIJRequest.Cijid > 0)
            {
                <button formmethod="post" type="submit" form="cijForm" class="btn btn-success" formaction="@Url.Action("SubmitRequest","CIJ")">Submit</button>
                <button formmethod="post" type="submit" form="cijForm" formaction="@Url.Action("SaveCIJ","CIJ")" class="btn btn-warning">Update</button>
            }
            else
            {
                <button formmethod="post" type="submit" form="cijForm" formaction="@Url.Action("SaveCIJ","CIJ")" class="btn btn-warning">Save</button>
            }
            <a asp-controller="CIJ" asp-action="Dashboard" class="btn btn-secondary"> Cancel </a>
        </div>
    </form>
</div>

@section Scripts
{
    <script src="~/js/CIJMain.js"></script>
}